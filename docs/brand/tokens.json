  "oker_rule": {
    "allowed": {
      "OK-1": "linkerrand accentbalk/callout: max 1 per pagina (docx, per page-break-segment), 1 per slide, 1 per mail",
      "OK-2": "footerlijn in footer/master/layout: 1 per footer-definitie",
      "OK-3": "sig: 2px top-border + x-afbeelding (mail)",
      "OK-4": "bullet-glyph (numbering/buClr): onbeperkt",
      "OK-5": "accentlijntje titel/sectie-slide: shape h<=5pt, w<=1.5in, max 1 per slide"
    },
    "forbidden_zero": {
      "R-1": "oker (of tint/shade, of theme accent6) als tekstkleur, incl. hyperlinks",
      "R-2": "oker-vulling (incl. theme accent6 in elke tint, impliciete grafiekreeks)",
      "R-3": "oker als status",
      "R-4": "key figures bold navy/ink"
    },
    "near_oker": "deltaE76 < 10 of zelfde hue-familie (hue 20-50 deg, sat >= 0.08)",
    "exceptions": [
      "E-1 logo-assets op sha256",
      "E-2 OLE/embedded genegeerd",
      "E-3 derden: lint n.v.t.",
      "E-4 override-log (alleen Frederik)"
    ]
  },
  "mail": {
    "ref": "mail/mail_spacing_rule_v3.txt",
    "sig_ref": "mail/sig-master.html",
    "note": "mail niet via deze tokens; v3 + sig-master zijn SSOT"
  },
